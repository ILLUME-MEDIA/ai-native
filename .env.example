APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Example: https://javed.io,https://yoursite.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://javed.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_PUBLISHABLE_KEY="${STRIPE_PUBLISHABLE_KEY}"

# ===================================================================
# Git Integration Configuration
# ===================================================================

# Git Binary Path (leave empty for auto-detection)
# Windows: C:\Program Files\Git\cmd\git.exe
# Linux: /usr/bin/git
# macOS: /usr/local/bin/git
GIT_BINARY_PATH=

# Default Git User Configuration (used when initializing workspaces)
GIT_DEFAULT_USER_NAME="Workspace User"
GIT_DEFAULT_USER_EMAIL="workspace@example.com"

# Git Command Timeout (seconds)
GIT_TIMEOUT=300

# Git Logging
GIT_LOGGING_ENABLED=true
GIT_LOG_CHANNEL=daily

# Security Settings
GIT_DISABLE_FORCE_PUSH=true
GIT_REQUIRE_AUTH_REMOTE=true

# ===================================================================
# Workspace Configuration
# ===================================================================

# Legacy workspace Git timeout (for backward compatibility)
WORKSPACE_GIT_TIMEOUT=60

# Terminal command timeout
WORKSPACE_TERMINAL_TIMEOUT=300

# ===================================================================
# OTP Auth + Resend Integration
# ===================================================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be a verified domain on Resend (e.g. noreply@yourdomain.com)
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME="${APP_NAME}"

# OTP Settings
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Sanctum token lifetime in days (issued after successful OTP verify)
OTP_TOKEN_EXPIRES_DAYS=30

# Admin key to protect settings/tables/logs endpoints (leave empty = open in dev)
# Generate: php artisan key:generate --show  or use any random 40-char string
OTP_ADMIN_KEY=

# ===================================================================
# Stripe Payment Integration
# ===================================================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================================================
# DoorDash Drive API Integration
# ===================================================================
# Get credentials from: https://developer.doordash.com/portal
DOORDASH_DEVELOPER_ID=your-developer-id-here
DOORDASH_KEY_ID=your-key-id-here
DOORDASH_SIGNING_SECRET=your-signing-secret-here
# Leave as default for production; use sandbox for testing:
# DOORDASH_BASE_URL=https://openapi.doordash.com

# ===================================================================
# Square POS Integration
# ===================================================================
# Get from: https://developer.squareup.com/apps
SQUARE_APP_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_APP_SECRET=sandbox-sq0csb-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox
# Get from: https://developer.squareup.com/apps → Webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ===================================================================
# Clover POS Integration
# ===================================================================
# Get from: https://sandbox.dev.clover.com/developer-home/create-app
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# "sandbox" or "production"
CLOVER_ENVIRONMENT=sandbox
